  {
   "who": "Iravatham Mahadevan",
   "year": 1977,
   "signs": 417,
   "note": "The Indus Script: Texts, Concordance and Tables (Archaeological Survey of India). 2,906 texts; later counts 419 signs and 2,911 texts. Read online at the Roja Muthiah Research Library.",
   "url": "https://www.rmrl.in/en/dl/research-papers/mahadevan"
  },
  {
   "who": "Asko Parpola",
   "year": 1994,
   "signs": 386,
   "note": "Deciphering the Indus Script (Cambridge University Press); also the Corpus of Indus Seals and Inscriptions."
  },
  {
   "who": "Bryan K. Wells",
   "year": 2015,
   "signs": 694,
   "note": "The Archaeology and Epigraphy of Indus Writing (Archaeopress)."
  }
 ],
 "facts": [
  "More than 4,700 inscribed objects are known: stamp seals, sealings, copper plates, small tablets, pottery and ivory rods.",
  "Most texts are short: about five signs on average; the longest has a few dozen.",
  "Texts on seals usually run from right to left; impressions show them reversed.",
  "There is no bilingual text, and the script has not been deciphered. Claims of decipherment, including links to Brahmi, are debated."
 ],
