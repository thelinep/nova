{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NOVA Runtime",
  "version": "0.1.0",
  "identifier": "com.brahmini.nova-runtime",
  "build": {
    "devUrl": "http://127.0.0.1:8787",
    "frontendDist": "../../public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "NOVA Runtime",
        "url": "http://127.0.0.1:8787",
        "width": 1360,
        "height": 860,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "dmg", "nsis"],
    "icon": ["icons/icon.icns"],
    "resources": {
      "../../server.js": "server.js",
      "../../package.json": "package.json",
      "../../lib/**/*": "lib/",
      "../../mcp-servers/**/*": "mcp-servers/",
      "../../skills/**/*": "skills/",
      "../../public/**/*": "public/"
    }
  }
}
