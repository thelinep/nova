{
  "name": "nova-runtime",
  "version": "0.1.0",
  "description": "NOVA Runtime — local backend for the NOVA Console prototype. Real SQLite persistence, real Ollama-backed streaming inference, real CPU/RAM/GPU telemetry. Zero npm dependencies by design — everything here runs on what Node 22+ ships built in (node:sqlite, global fetch, node:http), so there is nothing to install and nothing that can fail to compile on your machine.",
  "private": true,
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "start": "node --no-warnings server.js",
    "dev": "node --no-warnings --watch server.js",
    "launch": "node packaging/launch.js",
    "test": "node --test tests/*.test.js",
    "test:ui": "playwright test",
    "test:e2e": "playwright test",
    "test:browser": "playwright test --config=playwright.browser.config.js --reporter=line",
    "test:jobs": "node --test tests/jobs.test.js",
    "test:policy": "node --test tests/policy.test.js",
    "test:rollback": "node --test tests/rollback.test.js",
    "test:budgets": "node --test tests/budgets.test.js",
    "test:killswitch": "node --test tests/killswitch.test.js",
    "test:autonomy": "node --test tests/autonomy.test.js",
    "test:workspace-autonomy": "node --test tests/workspace-autonomy.test.js",
    "test:l2": "node --test tests/l2-certify.test.js",
    "l2:check": "node scripts/l2-check.js",
    "test:workbench": "node --test tests/workbench.test.js",
    "test:rust": "cargo test --manifest-path packaging/tauri/Cargo.toml",
    "test:ollama-planner": "node --no-warnings scripts/validate-real-code-planner.js",
    "test:all": "npm test && npm run test:ui && npm run test:rust",
    "test:constellation": "node --test tests/constellation.test.js",
    "test:test-synthesis": "node --test tests/test-synthesis.test.js",
    "test:semantic-vote": "node --test tests/semantic-vote.test.js",
    "test:dafny-pro": "node --test tests/dafny-pro.test.js",
    "test:clover": "node --test tests/clover.test.js",
    "test:ollama-provider": "node --test tests/ollama-provider.test.js",
    "test:dafny-cli": "node --test tests/dafny-cli.test.js",
    "test:correctness-pipeline": "node --test tests/correctness-pipeline.test.js",
    "test:workbench-actions": "node --test tests/workbench-actions.test.js",
    "test:activation": "node --test tests/activation.test.js",
    "test:connectors": "node --test tests/connectors.test.js",
    "test:secrets": "node --test tests/secrets.test.js",
    "test:github-connector": "node --test tests/github-connector.test.js",
    "test:connector-actions": "node --test tests/connector-actions.test.js",
    "test:agents": "node --test tests/agents.test.js",
    "test:agent-memory": "node --test tests/agent-memory.test.js",
    "test:agent-tasks": "node --test tests/agent-tasks.test.js",
    "test:agent-budgets": "node --test tests/agent-budgets.test.js",
    "test:agent-tools": "node --test tests/agent-tools.test.js",
    "test:agent-supervisor": "node --test tests/agent-supervisor.test.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
