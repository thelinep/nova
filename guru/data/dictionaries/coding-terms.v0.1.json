    {"id":"condition","definition_en":"A rule or expression that determines which action should occur.","terms":{"sa":{"preferred":"अवस्था","aliases":["शर्त"]},"hi":{"preferred":"शर्त","aliases":["condition"]},"en":{"preferred":"condition","aliases":[]},"ur":{"preferred":"شرط","aliases":[]},"ru":{"preferred":"условие","aliases":[]},"zh-Hans":{"preferred":"条件","aliases":[]}},"review_status":"draft"},
