  "entries": [
    {"id":"algorithm","definition_en":"A precise sequence of steps for solving a problem or computing a result.","terms":{"sa":{"preferred":"कलनविधिः","aliases":["गणनाविधिः"]},"hi":{"preferred":"कलनविधि","aliases":["एल्गोरिदम"]},"en":{"preferred":"algorithm","aliases":[]},"ur":{"preferred":"الگورتھم","aliases":["طریقۂ حساب"]},"ru":{"preferred":"алгоритм","aliases":[]},"zh-Hans":{"preferred":"算法","aliases":[]}},"review_status":"draft"},
    {"id":"program","definition_en":"A set of instructions that a computer can execute.","terms":{"sa":{"preferred":"सङ्गणककार्यक्रमः","aliases":["कार्यक्रमः"]},"hi":{"preferred":"प्रोग्राम","aliases":["कार्यक्रम"]},"en":{"preferred":"program","aliases":[]},"ur":{"preferred":"پروگرام","aliases":[]},"ru":{"preferred":"программа","aliases":[]},"zh-Hans":{"preferred":"程序","aliases":[]}},"review_status":"draft"},
